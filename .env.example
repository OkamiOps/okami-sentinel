# Copy via `node scripts/docker/setup.mjs` for a local-only installation.
# Do not store the secret values or paths inside the Git checkout.
CSB_COMPOSE_PROJECT_NAME=okami-sentinel
CSB_GITHUB_ACTIONS_WORKFLOW_SHA=replace-with-40-character-release-sha
CSB_PUBLIC_ORIGIN=http://127.0.0.1:8787
CSB_LOCAL_PORT=8787
CSB_ADMIN_USER=admin
CSB_ADMIN_PASSWORD_PATH=/absolute/path/outside-the-checkout/admin_password
CSB_VAULT_KEY_PATH=/absolute/path/outside-the-checkout/vault_key

# Used only with compose.local.yaml. This is a path on the Docker daemon host.
CSB_REPOSITORY_PATH=/absolute/path/to/an-authorized-repository
